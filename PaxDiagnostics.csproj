<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PaxDiagnostics</RootNamespace>
    <AssemblyName>PaxDiagnostics</AssemblyName>
    <Version>1.0.0</Version>
    <Product>PAX Diagnostics</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Rendered by the app's write-icon option (see README); a fresh clone builds without it. -->
    <ApplicationIcon Condition="Exists('Assets\PaxDiagnostics.ico')">Assets\PaxDiagnostics.ico</ApplicationIcon>
    <!-- Keep memory low: no background GC thread, no profile-guided tiering, no ICU culture data. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <!-- Native graphics libs ship large debug symbols; keep the install lean. -->
  <Target Name="TrimPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PruneFiles Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PruneFiles)" />
  </Target>

</Project>
